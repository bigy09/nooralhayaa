# Back-office admin scaffold environment example
MONGODB_URI=mongodb://localhost:27017/backoffice-admin
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
CORS_ORIGINS=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeNow123!
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000
# URL publique du site principal, utilisée pour construire l'URL absolue des
# images uploadées depuis ce back office (ex: https://votre-app.up.railway.app)
ASSET_BASE_URL=
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_app_password
