{
  "name": "app-assata-web",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "backoffice-scaffold/backend",
    "backoffice-scaffold/frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "frontend:dev": "npm run dev --prefix frontend",
    "backend:dev": "npm run dev --prefix backend",
    "build": "npm run build --prefix frontend",
    "postinstall": "npm run build --prefix frontend",
    "start": "node backend/index.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "mongoose": "^9.6.2",
    "nodemailer": "^8.0.7"
  }
}
